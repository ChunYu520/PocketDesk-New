<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PocketDesk.Settings.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="PocketDesk 设置">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="AppTitleBar"
              Height="48"
              Padding="16,0,150,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="24" Height="24" CornerRadius="6" Background="#334CC2FF">
                    <FontIcon Glyph="&#xE8B7;" FontSize="12" Foreground="#4CC2FF" />
                </Border>
                <TextBlock Text="PocketDesk 设置"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="Gray" VerticalAlignment="Center" />
                <TextBlock x:Name="TitleStatusText" Text="正在连接…" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView x:Name="Nav"
                        Grid.Row="1"
                        PaneDisplayMode="Left"
                        OpenPaneLength="248"
                        CompactPaneLength="48"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsTitleBarAutoPaddingEnabled="False"
                        Background="Transparent"
                        SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="常规" Tag="general">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="组件" Tag="widgets">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE71D;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="收纳盒" Tag="boxes">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="存储与诊断" Tag="storage">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7C3;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <StackPanel Margin="14,4,14,12" Spacing="6">
                    <Button x:Name="RefreshButton" Content="刷新" FontSize="12" Padding="10,5" Click="OnRefreshClick" HorizontalAlignment="Stretch" />
                    <TextBlock Text="PocketDesk-New 1.0.0" FontSize="10" Opacity="0.55" Margin="2,0,0,0" />
                </StackPanel>
            </NavigationView.PaneFooter>
            <ScrollViewer x:Name="ContentScroll"
                          Padding="32,20,32,36"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="1040" HorizontalAlignment="Stretch" Spacing="0">
                    <InfoBar x:Name="MessageBar"
                             IsOpen="False"
                             IsClosable="True"
                             Margin="0,0,0,16" />
                    <Grid x:Name="ContentHost" />
                </StackPanel>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>
