<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PocketDesk.Settings.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="PocketDesk 设置">

    <Grid x:Name="RootGrid" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <NavigationView x:Name="Nav"
                        PaneDisplayMode="Left"
                        OpenPaneLength="260"
                        CompactPaneLength="48"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="常规" Tag="general" Icon="Setting" />
                <NavigationViewItem Content="组件" Tag="widgets" Icon="AllApps" />
                <NavigationViewItem Content="收纳盒" Tag="boxes" Icon="Folder" />
                <NavigationViewItem Content="存储与诊断" Tag="storage" Icon="SaveLocal" />
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <StackPanel Margin="14,6,14,10" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="Gray" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Text="正在连接…" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button x:Name="RefreshButton" Content="重新连接" FontSize="12" Padding="8,4" Click="OnRefreshClick" />
                </StackPanel>
            </NavigationView.PaneFooter>
            <ScrollViewer x:Name="ContentScroll" Padding="28,20,28,32"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="1100" HorizontalAlignment="Stretch" Spacing="0">
                    <InfoBar x:Name="MessageBar"
                             IsOpen="False"
                             IsClosable="True"
                             Margin="0,0,0,14" />
                    <Grid x:Name="ContentHost" />
                </StackPanel>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>
